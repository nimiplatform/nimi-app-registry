{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.nimi.ai/schema/common.schema.json",
  "$defs": {
    "appId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "minLength": 3,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "githubNamespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "nullableHttpsUri": {
      "anyOf": [
        { "$ref": "#/$defs/httpsUri" },
        { "type": "null" }
      ]
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._@+/-]+$",
      "minLength": 1,
      "maxLength": 500
    },
    "targetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "descriptorId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$",
      "maxLength": 200
    },
    "descriptorPath": {
      "type": "string",
      "pattern": "^descriptors/[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+/(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?\\.json$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_namespace",
        "namespace_kind",
        "assurance",
        "verified_domain_ref",
        "kyc_ref"
      ],
      "properties": {
        "github_namespace": { "$ref": "#/$defs/githubNamespace" },
        "namespace_kind": { "enum": ["user", "organization"] },
        "assurance": {
          "enum": ["pseudonymous", "domain-verified", "identity-verified"]
        },
        "verified_domain_ref": { "$ref": "#/$defs/nullableHttpsUri" },
        "kyc_ref": { "$ref": "#/$defs/nullableHttpsUri" }
      },
      "allOf": [
        {
          "if": { "properties": { "assurance": { "const": "pseudonymous" } } },
          "then": {
            "properties": {
              "verified_domain_ref": { "type": "null" },
              "kyc_ref": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "assurance": { "const": "domain-verified" } } },
          "then": {
            "properties": {
              "namespace_kind": { "const": "organization" },
              "verified_domain_ref": { "$ref": "#/$defs/httpsUri" },
              "kyc_ref": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "assurance": { "const": "identity-verified" } } },
          "then": {
            "properties": {
              "namespace_kind": { "const": "organization" },
              "kyc_ref": { "$ref": "#/$defs/httpsUri" }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "license"],
      "properties": {
        "repository": {
          "allOf": [
            { "$ref": "#/$defs/httpsUri" },
            { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" }
          ]
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx_expression", "files"],
          "properties": {
            "spdx_expression": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.+()-]+(?: (?:AND|OR|WITH) [A-Za-z0-9.+()-]+)*$",
              "minLength": 2,
              "maxLength": 200
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": { "$ref": "#/$defs/relativePath" },
                  "sha256": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "tag_protection_ref",
        "commit_sha",
        "release_id",
        "release_url",
        "release_notes_url",
        "immutable",
        "prerelease"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
        },
        "tag_protection_ref": { "$ref": "#/$defs/httpsUri" },
        "commit_sha": { "$ref": "#/$defs/commitSha" },
        "release_id": { "type": "integer", "minimum": 1 },
        "release_url": { "$ref": "#/$defs/httpsUri" },
        "release_notes_url": { "$ref": "#/$defs/httpsUri" },
        "immutable": { "const": true },
        "prerelease": { "const": false }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runtime_kind", "registration_mode", "sandbox_ref"],
      "properties": {
        "kind": { "const": "nimiapp" },
        "runtime_kind": { "const": "native" },
        "registration_mode": { "const": "app-managed" },
        "sandbox_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "storagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "os_storage_disclosure"],
      "properties": {
        "kind": { "enum": ["nimi-mediated-default", "app-owned-os-storage"] },
        "os_storage_disclosure": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path_pattern", "purpose", "retention", "removal"],
                "properties": {
                  "path_pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "retention": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "removal": { "type": "string", "minLength": 1, "maxLength": 500 }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "nimi-mediated-default" } } },
          "then": { "properties": { "os_storage_disclosure": { "type": "null" } } },
          "else": { "properties": { "os_storage_disclosure": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostics_bundle_fields",
        "redaction_rules",
        "issue_categories",
        "escalation_url",
        "kill_switch_visibility",
        "recovery_instructions"
      ],
      "properties": {
        "diagnostics_bundle_fields": { "$ref": "#/$defs/stringList" },
        "redaction_rules": { "$ref": "#/$defs/stringList" },
        "issue_categories": { "$ref": "#/$defs/stringList" },
        "escalation_url": { "$ref": "#/$defs/httpsUri" },
        "kill_switch_visibility": { "enum": ["visible", "maintainer-only"] },
        "recovery_instructions": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "nativeTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signing_subject",
        "observed_subject",
        "entitlements_ref",
        "windows_code_signing",
        "macos_notarization",
        "macos_developer_id_subject"
      ],
      "properties": {
        "signing_subject": { "enum": ["publisher", null] },
        "observed_subject": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        },
        "entitlements_ref": { "$ref": "#/$defs/nullableHttpsUri" },
        "windows_code_signing": { "enum": ["signed", "unsigned", "not-applicable"] },
        "macos_notarization": { "enum": ["notarized", "absent", "not-applicable"] },
        "macos_developer_id_subject": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        }
      }
    },
    "aggregateAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_name", "asset_url", "size", "sha256"],
      "properties": {
        "asset_id": { "type": "integer", "minimum": 1 },
        "asset_name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "asset_url": { "$ref": "#/$defs/httpsUri" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "os",
        "arch",
        "asset_id",
        "asset_name",
        "asset_url",
        "size",
        "sha256",
        "runtime_entry",
        "provenance_attestation_refs",
        "provenance_revision",
        "execution_profile_ref",
        "native_trust"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/targetId" },
        "os": { "enum": ["windows", "macos"] },
        "arch": { "enum": ["x86_64", "arm64"] },
        "asset_id": { "type": "integer", "minimum": 1 },
        "asset_name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "asset_url": { "$ref": "#/$defs/httpsUri" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "runtime_entry": { "$ref": "#/$defs/relativePath" },
        "provenance_attestation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/httpsUri" }
        },
        "provenance_revision": { "$ref": "#/$defs/commitSha" },
        "execution_profile_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
        "native_trust": { "$ref": "#/$defs/nativeTrust" }
      },
      "allOf": [
        {
          "if": { "properties": { "os": { "const": "windows" } } },
          "then": {
            "properties": {
              "target_id": { "type": "string", "pattern": "^windows-" },
              "execution_profile_ref": { "const": "windows-user-mode-as-invoker-v1" },
              "native_trust": {
                "type": "object",
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "windows_code_signing": { "enum": ["signed", "unsigned"] },
                      "macos_notarization": { "const": "not-applicable" },
                      "macos_developer_id_subject": { "type": "null" },
                      "entitlements_ref": { "type": "null" }
                    }
                  },
                  {
                    "type": "object",
                    "if": { "type": "object", "properties": { "windows_code_signing": { "const": "signed" } } },
                    "then": {
                      "type": "object",
                      "properties": {
                        "signing_subject": { "const": "publisher" },
                        "observed_subject": { "type": "string", "minLength": 1 }
                      }
                    },
                    "else": {
                      "type": "object",
                      "properties": {
                        "signing_subject": { "type": "null" },
                        "observed_subject": { "type": "null" }
                      }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "target_id": { "type": "string", "pattern": "^macos-" },
              "native_trust": {
                "type": "object",
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "windows_code_signing": { "const": "not-applicable" },
                      "macos_notarization": { "enum": ["notarized", "absent"] }
                    }
                  },
                  {
                    "type": "object",
                    "if": { "type": "object", "properties": { "signing_subject": { "const": "publisher" } } },
                    "then": {
                      "type": "object",
                      "properties": {
                        "observed_subject": { "type": "string", "minLength": 1 },
                        "macos_developer_id_subject": { "type": "string", "minLength": 1 }
                      }
                    },
                    "else": {
                      "type": "object",
                      "properties": {
                        "signing_subject": { "type": "null" },
                        "observed_subject": { "type": "null" },
                        "macos_developer_id_subject": { "type": "null" },
                        "macos_notarization": { "const": "absent" }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "if": { "type": "object", "properties": { "macos_notarization": { "const": "notarized" } } },
                    "then": {
                      "type": "object",
                      "properties": {
                        "signing_subject": { "const": "publisher" },
                        "macos_developer_id_subject": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id",
        "display_name",
        "version",
        "publisher",
        "source",
        "release",
        "aggregate",
        "package",
        "app_access",
        "capability_contract_refs",
        "required_standardized_feature_refs",
        "storage_policy",
        "update_channel",
        "rollback_marker",
        "support",
        "targets"
      ],
      "properties": {
        "app_id": { "$ref": "#/$defs/appId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "$ref": "#/$defs/version" },
        "publisher": { "$ref": "#/$defs/publisher" },
        "source": { "$ref": "#/$defs/source" },
        "release": { "$ref": "#/$defs/release" },
        "aggregate": { "$ref": "#/$defs/aggregateAsset" },
        "package": { "$ref": "#/$defs/package" },
        "app_access": { "$ref": "#/$defs/stringList" },
        "capability_contract_refs": { "$ref": "#/$defs/stringList" },
        "required_standardized_feature_refs": { "$ref": "#/$defs/stringList" },
        "storage_policy": { "$ref": "#/$defs/storagePolicy" },
        "update_channel": { "enum": ["stable", "beta"] },
        "rollback_marker": { "enum": ["none", "previous-admitted-release"] },
        "support": { "$ref": "#/$defs/support" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/target" }
        }
      }
    }
  }
}
