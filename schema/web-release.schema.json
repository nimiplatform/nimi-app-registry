{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.nimi.ai/schema/web-release.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_id",
    "client_id",
    "version",
    "source_revision",
    "commit_sha",
    "release_id",
    "asset_id",
    "size",
    "sha256",
    "app_access",
    "capability_contract_refs",
    "review"
  ],
  "properties": {
    "app_id": {
      "$ref": "common.schema.json#/$defs/appId"
    },
    "client_id": {
      "$ref": "common.schema.json#/$defs/clientId"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "commit_sha": {
      "$ref": "common.schema.json#/$defs/commitSha"
    },
    "release_id": {
      "type": "integer",
      "minimum": 1
    },
    "asset_id": {
      "type": "integer",
      "minimum": 1
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "app_access": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "capability_contract_refs": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "review": {
      "$ref": "approved-descriptor.schema.json#/properties/admission/properties/review"
    }
  }
}
